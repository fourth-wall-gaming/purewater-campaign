    "arc": {
      "acts": [
        {
          "act": "I",
          "when": "d6 to d7",
          "title": "THE HUNT",
          "for": "Put Nimras in reach of his quarry and a physical magical threat. G1 offers pursuit, counter-magic, restraint, bargaining and an early recovery that stands.",
          "takes": "At risk are the teacher's freedom, the manuscript and people in the hunt's path. No injury, capture or escape is predetermined.",
          "index_from": 88,
          "index_to": 95
        },
        {
          "act": "II",
          "when": "d7 to d8",
          "title": "THE PACK",
          "for": "Contest workshop, handlers, copies and transport. G2 and G3 are actual attempts requiring surviving assets and information. Authorities and city powers can provide real help. Nimras can separate rivals or strike their dependencies in any order.",
          "takes": "At risk are control of the constructs, custody of useful research and the ability to prevent coercive export. No compulsory betrayal or compensating defeat.",
          "index_from": 92,
          "index_to": 99
        },
        {
          "act": "III",
          "when": "d8 to d10",
          "title": "WHO KEEPS THE HOUNDS",
          "for": "Settle surviving transport, research and personal obligations. G4 cannot depart without actual loading and pilot; G5 can resolve immediately whenever recovery is achieved. Recalculate dates after play, and never hold an early victory for this act.",
          "takes": "At risk are lasting availability of mage-hunting tools and professional relationships. Clear victory, partial victory, negotiated settlement, failure and withdrawal have distinct concrete results in the GM plan.",
          "index_from": 96,
          "index_to": 107
        }
      ],
      "now": "I"
    },
