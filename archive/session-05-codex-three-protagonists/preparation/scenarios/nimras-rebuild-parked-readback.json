  "arc": {
    "acts": [
      {
        "act": "I",
        "when": "d6 to d7",
        "title": "THE FAVOUR AND THE ERRAND",
        "for": "Expose the waterfront's competing organisations through consequential choices about people, cargo and authority. Bring Nimras's outside commission into that city through Vey's offered case and an independently reachable teacher at Lantern Float Market. Let Nimras decide how to approach recovery rather than require loyalty to a particular patron.",
        "takes": "At risk: cargo, safe access, independent livelihoods, trust between teacher and pupil, and possession of the entrusted manuscript. Actual losses require events and failed resistance; nothing is forfeited merely for entering the act.",
        "index_from": 88,
        "index_to": 95
      },
      {
        "act": "II",
        "when": "d8 to d10",
        "title": "THE WATERFRONT DIVIDES",
        "for": "Offer physical objectives involving money, boats, armed control and closed routes. If the teacher's survey or recovery remains live, braid Nimras's hunt into existing Q5 at the Old Customs Cisterns. His magic, investigation, social work and fieldcraft can alter access and protect or obstruct actual people. Opponents use surviving resources and earned knowledge.",
        "takes": "At risk: free passage, homes, market safety, research access and lives during any actual armed clearance. Effective intervention can prevent these consequences. No necessary casualty, teacher betrayal or PC setback.",
        "index_from": 96,
        "index_to": 107
      },
      {
        "act": "III",
        "when": "d11 to d12",
        "title": "WHO HOLDS THE WATER",
        "for": "Resolve control of the waterfront using the assets and opportunities that survived play. If Nimras's commission is still open, make any agreed return or handover a concrete operation along actual available routes. Give him authority over his own promises and report to his employer. Support victory, negotiated settlement, partial success, defeat or withdrawal without a predetermined ending.",
        "takes": "At risk: lasting freedom of carriage, displaced crews' futures, the manuscript's custody and Nimras's professional relationships. None must be lost by design; actual outcomes determine the price.",
        "index_from": 108,
        "index_to": 115
      }
    ],
    "now": "I"
  },
